# 寻晤智能agent系统 — 环境变量样例
#
# 用法：复制为 .env 后按需修改。
# docker compose 会自动读取当前目录的 .env（变量名需与下方一致）。

# ===================== 接口鉴权（强烈建议配置） =====================
# 后端所有 /api/** 接口默认要求请求头：
#   Authorization: Bearer <本值>
# 留空 = 关闭鉴权（启动时后端会打 warn，仅建议本地开发）。
# 前端首次进入会要求输入该令牌。生成示例：
#   openssl rand -hex 24
XUNWU_AUTH_TOKEN=

# ===================== DeepSeek（可选） =====================
# 不配置也能运行 —— 系统默认使用 Ollama 本地模型 qwen2.5:7b。
# 填写后 ChatClientRegistry 会注册 deepseek-chat。
DEEPSEEK_API_KEY=
#DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===================== 智谱 GLM（可选） =====================
ZHIPU_API_KEY=

# ===================== LongCat（可选） =====================
# 填写后 ChatClientRegistry 会注册 LongCat-2.5（OpenAI 兼容协议）
LONGCAT_API_KEY=
#LONGCAT_BASE_URL=https://api.longcat.chat/openai/v1
#LONGCAT_MODEL=LongCat-2.5

# ===================== 本地 Ollama =====================
# Docker 部署时指向 compose 服务名；本地调试指向本机。
OLLAMA_BASE_URL=http://localhost:11434

# ===================== 数据库 =====================
# 本地开发（后端跑在宿主机）使用 localhost；容器内请使用服务名 xunwu-postgres。
DB_URL=jdbc:postgresql://localhost:5432/xunwu_agent
DB_USERNAME=xunwu
DB_PASSWORD=xunwu123

# ===================== 跨域（可选） =====================
# 仅前后端分离开发时需要。生产环境由 nginx 同源反代，无需配置。
# 多个来源用英文逗号分隔。
#XUNWU_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
