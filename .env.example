# 寻晤智能agent系统 — 环境变量样例
#
# 用法：复制为 .env 后按需修改。
# docker compose 会自动读取当前目录的 .env（变量名需与下方一致）。

# ===================== DeepSeek（可选） =====================
# 不配置也能运行 —— 系统默认使用 Ollama 本地模型 qwen2.5:7b。
# 填写后 ChatClientRegistry 会注册 deepseek-chat。
DEEPSEEK_API_KEY=
#DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===================== 智谱 GLM（可选） =====================
ZHIPU_API_KEY=

# ===================== 本地 Ollama =====================
# Docker 部署时指向 compose 服务名；本地调试指向本机。
OLLAMA_BASE_URL=http://localhost:11434

# ===================== 数据库 =====================
# 本地开发（后端跑在宿主机）使用 localhost；容器内请使用服务名 xunwu-postgres。
DB_URL=jdbc:postgresql://localhost:5432/xunwu_agent
DB_USERNAME=xunwu
DB_PASSWORD=xunwu123

# ===================== 跨域（可选） =====================
# 仅前后端分离开发时需要。生产环境由 nginx 同源反代，无需配置。
# 多个来源用英文逗号分隔。
#XUNWU_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
