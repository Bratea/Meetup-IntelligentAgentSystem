<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xunwu.agent.mapper.KnowledgeDocumentMapper">

    <resultMap id="BaseResultMap" type="com.xunwu.agent.entity.KnowledgeDocument">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="content" property="content"/>
        <result column="status" property="status"/>
        <result column="segment_count" property="segmentCount"/>
        <result column="error_message" property="errorMessage"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, name, content, status, segment_count, error_message, created_at, updated_at
    </sql>

    <insert id="insert" parameterType="com.xunwu.agent.entity.KnowledgeDocument"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO knowledge_document
            (name, content, status, segment_count, error_message, created_at, updated_at)
        VALUES (#{name}, #{content}, #{status}, #{segmentCount}, #{errorMessage}, now(), now())
    </insert>

    <update id="update" parameterType="com.xunwu.agent.entity.KnowledgeDocument">
        UPDATE knowledge_document
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="content != null">content = #{content},</if>
            <if test="status != null">status = #{status},</if>
            <if test="segmentCount != null">segment_count = #{segmentCount},</if>
            <if test="errorMessage != null">error_message = #{errorMessage},</if>
            updated_at = now()
        </set>
        WHERE id = #{id}
    </update>

    <update id="updateSegmentCount">
        UPDATE knowledge_document
        SET segment_count = #{segmentCount}, updated_at = now()
        WHERE id = #{id}
    </update>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM knowledge_document
        WHERE id = #{id}
    </select>

    <resultMap id="SummaryResultMap" type="com.xunwu.agent.entity.KnowledgeDocument">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="content_preview" property="contentPreview"/>
        <result column="status" property="status"/>
        <result column="segment_count" property="segmentCount"/>
        <result column="error_message" property="errorMessage"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM knowledge_document
    </select>

    <!-- 列表接口不返回正文，避免为了一行预览传输整篇文档 -->
    <select id="selectSummaryPage" resultMap="SummaryResultMap">
        SELECT id, name, LEFT(content, 200) AS content_preview,
               status, segment_count, error_message, created_at, updated_at
        FROM knowledge_document
        ORDER BY updated_at DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <delete id="deleteById">
        DELETE FROM knowledge_document WHERE id = #{id}
    </delete>

</mapper>
