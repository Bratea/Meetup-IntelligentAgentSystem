<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xunwu.agent.mapper.MessageMapper">

    <resultMap id="BaseResultMap" type="com.xunwu.agent.entity.Message">
        <id column="id" property="id"/>
        <result column="conversation_id" property="conversationId"/>
        <result column="role" property="role"/>
        <result column="content" property="content"/>
        <result column="model" property="model"/>
        <result column="tool_calls" property="toolCalls"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, conversation_id, role, content, model, tool_calls, created_at
    </sql>

    <insert id="insert" parameterType="com.xunwu.agent.entity.Message"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO message (conversation_id, role, content, model, tool_calls, created_at)
        VALUES (#{conversationId}, #{role}, #{content}, #{model}, #{toolCalls}, now())
    </insert>

    <select id="selectByConversationId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM message
        WHERE conversation_id = #{conversationId}
        ORDER BY id ASC
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM message
        WHERE id = #{id}
    </select>

    <delete id="deleteById">
        DELETE FROM message WHERE id = #{id}
    </delete>

</mapper>
